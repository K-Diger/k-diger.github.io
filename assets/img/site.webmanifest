---
layout: null
---
{%- assign favicon_path = "/assets/img/favicons" | relative_url -%}
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "icons": [
    { "src": "{{ favicon_path }}/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ favicon_path }}/web-app-manifest-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "start_url": "{{ '/' | relative_url }}",
  "theme_color": "#fbfbfa",
  "background_color": "#fbfbfa",
  "display": "standalone"
}
